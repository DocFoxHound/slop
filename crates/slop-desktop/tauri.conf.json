{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slop",
  "version": "0.1.0",
  "identifier": "dev.ironpoint.slop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../web" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../web" }
  },
  "app": {
    "windows": [
      {
        "title": "Slop",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:8080 http://127.0.0.1:8080",
        "frame-ancestors": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A store for open-source apps and games made with AI",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
