{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slop",
  "version": "0.1.0",
  "identifier": "dev.ironpoint.slop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../web"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../web"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Slop",
        "visible": false,
        "center": true,
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:5173",
        "frame-ancestors": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A store for open-source apps and games made with AI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    },
    "publisher": "IronPoint Development",
    "copyright": "Copyright © 2026 IronPoint Development LLC",
    "homepage": "https://slop.188-68-41-241.sslip.io"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCOUQzODg5OUZDODgxQzYKUldUR2djaWZpVGlkYTluOTk5Vmh1bGFJTVljRGFYOGROMlF6cTZVSFVKWm9FUldubGdYaXZ3Z2cK",
      "endpoints": [
        "https://slop.188-68-41-241.sslip.io/v1/desktop/update/{{target}}/{{arch}}/{{current_version}}?bundle={{bundle_type}}"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
