{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Slop UI may ask the desktop shell to do. Keep this list short (docs/SECURITY.md §7).",
  "windows": ["main", "login"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    "allow-api-request",
    "allow-session-status",
    "allow-sign-in-start",
    "allow-sign-in-finish",
    "allow-sign-out",
    "allow-show-login",
    "allow-continue-signed-out",
    "allow-update-status",
    "allow-install-update",
    "allow-platform-info",
    "allow-installed-apps",
    "allow-install-app",
    "allow-uninstall-app",
    "allow-launch-app",
    "allow-run-installer",
    "allow-chat"
  ]
}
