# Copy to .env and fill in. .env is git-ignored; never commit secrets.
DATABASE_URL=postgres://slop:slop@127.0.0.1:5433/slop
SLOP_BIND=127.0.0.1:8080
# Public origin of the site. https turns on Secure/__Host- cookies and HSTS.
SLOP_PUBLIC_URL=http://localhost:8080
# GitHub OAuth app (https://github.com/settings/developers). Callback URL:
#   <SLOP_PUBLIC_URL>/v1/auth/github/callback
# Leave empty to run with sign-in off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Extra origins allowed to send state-changing requests, comma-separated (e.g. a dev web server).
SLOP_TRUSTED_ORIGINS=
# Origins allowed to read the API cross-origin without cookies: the packaged desktop app.
# SLOP_CORS_ORIGINS=tauri://localhost,http://tauri.localhost
SLOP_CORS_ORIGINS=
# Header the CDN/load balancer sets with the viewer's country (e.g. CloudFront-Viewer-Country).
# Signed-out viewers with no country get the under-18 view.
SLOP_COUNTRY_HEADER=
# Catalog rules (DESIGN §8). Defaults shown.
SLOP_DEAD_AFTER_DAYS=90
SLOP_COMING_SOON_DAYS=30
SLOP_BETA_DAYS=365
