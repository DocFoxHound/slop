# Copy to .env and fill in. .env is git-ignored; never commit secrets.
DATABASE_URL=postgres://slop:slop@127.0.0.1:5433/slop
SLOP_BIND=127.0.0.1:8080
# Public origin of the site. https turns on Secure/__Host- cookies and HSTS.
SLOP_PUBLIC_URL=http://localhost:8080
# GitHub OAuth app (https://github.com/settings/developers). Callback URL:
#   <SLOP_PUBLIC_URL>/v1/auth/github/callback
# Leave empty to run with sign-in off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Extra origins allowed to send state-changing requests, comma-separated (e.g. a dev web server).
SLOP_TRUSTED_ORIGINS=
# Header the CDN/load balancer sets with the viewer's country (e.g. CloudFront-Viewer-Country).
# Signed-out viewers with no country get the under-18 view.
SLOP_COUNTRY_HEADER=
# Catalog rules (DESIGN §8). Defaults shown.
SLOP_DEAD_AFTER_DAYS=90
SLOP_COMING_SOON_DAYS=30
SLOP_BETA_DAYS=365
# Release signing (base64 Ed25519 secret; `cargo run -p slop-api -- keys generate`).
# Without it, releases can't be approved and there's no revocation list.
SLOP_SIGNING_KEY=
# Largest release file Slop will fetch and hash (default 2 GiB, GitHub's own limit).
SLOP_MAX_FILE_BYTES=2147483648
# Development only: allow release files on plain http (e.g. a local test server).
SLOP_ALLOW_HTTP_DOWNLOADS=false
# Refuse to approve builds without a verified maker signature (GitHub artifact attestation).
# Only set to false for local development.
SLOP_REQUIRE_MAKER_SIGNATURE=true
# Prefix of Slop Build's shared recipe workflow, for the "Built by Slop Build" label (optional).
SLOP_BUILD_WORKFLOW=
# Optional GitHub token for higher rate limits on commit and attestation lookups.
GITHUB_TOKEN=
# Rate limits per client IP, requests per minute (sign-in endpoints, writes, reads).
SLOP_RATE_AUTH_PER_MIN=20
SLOP_RATE_WRITE_PER_MIN=60
SLOP_RATE_READ_PER_MIN=600
# Header with the client's IP, set by the load balancer (e.g. x-forwarded-for). Leave empty when
# clients connect directly; only set it if every request passes through a proxy that sets it.
SLOP_CLIENT_IP_HEADER=
