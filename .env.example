# Copy to .env and fill in. .env is git-ignored; never commit secrets.
DATABASE_URL=postgres://slop:slop@127.0.0.1:5434/slop
SLOP_BIND=127.0.0.1:8080
# Public origin of the site. https turns on Secure/__Host- cookies and HSTS.
SLOP_PUBLIC_URL=http://localhost:8080
# GitHub OAuth app (https://github.com/settings/developers). Callback URL:
#   <SLOP_PUBLIC_URL>/v1/auth/github/callback
# Leave empty to run with sign-in off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# More sign-ins (auth/oauth.rs), each off until set. Callback URLs to register with each:
#   {SLOP_PUBLIC_URL}/v1/auth/google/callback, …/gitlab/callback, …/bitbucket/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
# Extra origins allowed to send state-changing requests, comma-separated (e.g. a dev web server).
SLOP_TRUSTED_ORIGINS=
# Header the CDN/load balancer sets with the viewer's country (e.g. CloudFront-Viewer-Country).
# Signed-out viewers with no country get the under-18 view.
SLOP_COUNTRY_HEADER=
# Catalog rules (DESIGN §8). Defaults shown.
SLOP_DEAD_AFTER_DAYS=90
SLOP_COMING_SOON_DAYS=365
SLOP_BETA_DAYS=365
# Release signing (base64 Ed25519 secret; `cargo run -p slop-api -- keys generate`).
# Without it, releases can't be approved and there's no revocation list.
SLOP_SIGNING_KEY=
# Largest release file Slop will fetch and hash (default 2 GiB, GitHub's own limit).
SLOP_MAX_FILE_BYTES=2147483648
# Development only: allow release files on plain http (e.g. a local test server).
SLOP_ALLOW_HTTP_DOWNLOADS=false
# Refuse to approve builds without a verified maker signature (GitHub artifact attestation).
# Only set to false for local development.
SLOP_REQUIRE_MAKER_SIGNATURE=true
# Slop Build's recipe (slop-build/), as owner/repo/.github/workflows/build.yml, and the tag makers
# pin. Unset: Slop Build is off. Also drives the "Built by Slop Build" label.
SLOP_BUILD_WORKFLOW=
SLOP_BUILD_VERSION=v1
# GitHub token: higher rate limits, and access to private repositories (commit checks,
# attestations, and short-lived download links for release files). A fine-grained token with
# read-only "Contents" and "Metadata" on the repositories you test with.
GITHUB_TOKEN=
# Slop's GitHub App (deploy/README.md, "GitHub App"): release webhooks, and each repository's own
# API allowance. All four or none.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_WEBHOOK_SECRET=
# Rate limits per client IP, requests per minute (sign-in endpoints, writes, reads).
SLOP_RATE_AUTH_PER_MIN=20
SLOP_RATE_WRITE_PER_MIN=60
SLOP_RATE_READ_PER_MIN=600
# Anonymous repository and portfolio checks (/v1/check/…), per client IP per hour, and the GitHub
# API requests they may make per hour from every address together. They ask GitHub as nobody,
# sharing the server's anonymous allowance (60 an hour on github.com); 0 turns them off.
SLOP_RATE_CHECK_PER_HOUR=20
SLOP_CHECK_GITHUB_PER_HOUR=40
# Header with the client's IP, set by the load balancer (e.g. x-forwarded-for). Leave empty when
# clients connect directly; only set it if every request passes through a proxy that sets it.
# Behind Caddy on the same machine (deploy/README.md) it MUST be x-forwarded-for: otherwise every
# visitor shares one rate limit, and the admin panel raises an alert.
SLOP_CLIENT_IP_HEADER=
# The scan step (docs/ARCHITECTURE.md §6.3). Only "off" exists so far: files are recorded as not
# scanned, and the UI says so. A self-hosted scan service comes later.
SLOP_SCANNER=off
# Serve the built website (web/dist after `npm run build`) from the API, so one process runs the
# whole site on one address. Leave empty in development (Vite serves the site).
SLOP_WEB_DIR=
# People payments (people/stripe.rs): Stripe Connect platform keys. Unset: payments are off,
# or simulated with SLOP_PAYMENTS=simulated (development over http only; the sandbox always is).
STRIPE_SECRET_KEY=
# Each webhook endpoint has its own signing secret; list both, comma-separated.
STRIPE_WEBHOOK_SECRET=
SLOP_PAYMENTS=off
# Only a repository's GitHub owner may link it (repo_owner.rs). Leave on; the simulation sandbox
# turns it off because its players have no GitHub accounts.
SLOP_REQUIRE_REPO_OWNER=true
# VAT on Slop's fee (donations.rs, LEGAL §3.5): Slop's own VAT registration for fee statements,
# and the EU's VIES service for checking makers' VAT numbers ("off" to skip the check).
SLOP_VAT_ID=
SLOP_VIES_URL=https://ec.europa.eu/taxation_customs/vies/rest-api/check-vat-number
# Product emails (notify.rs): job steps, Interested apps, decisions, report outcomes. Unset:
# notifications stay in Slop's bell. smtps://user:pass@host:465 or smtp://user:pass@host:587.
SLOP_SMTP_URL=
SLOP_EMAIL_FROM=Slop <notifications@slop.example>
# Phone and browser notifications (push.rs): `slop-api keys generate-vapid`. Unset: off.
SLOP_VAPID_PRIVATE_KEY=
SLOP_VAPID_SUBJECT=https://slop.example

# Public repository of this Slop's source code (the AGPL offer on /source); unset until public.
# SLOP_SOURCE_URL=https://github.com/<owner>/slop
