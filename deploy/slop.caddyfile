# Slop's test deployment: copy to /etc/caddy/Caddyfile.d/ and reload Caddy
# (`caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile`).
#
# The server's own hostname is under happysrv.de, which shares Let's Encrypt's weekly certificate
# limit with every other customer of the host and has run out. sslip.io names resolve to the IP in
# them and get their own limit, so Caddy can get a certificate. Replace with a real domain later.
slop.188-68-41-241.sslip.io {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8090
}

# The simulation sandbox (docs/SIMULATION.md): made-up apps, players and votes.
sim.188-68-41-241.sslip.io {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8092
}

# Browser demos of new games (demos.rs): a separate origin, so a game's code never runs where
# Slop's sign-in cookies are. The API serves only demos here. Needs SLOP_PLAY_URL in slop.env.
play.188-68-41-241.sslip.io {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8090
}
