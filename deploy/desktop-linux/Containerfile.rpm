# Builds Slop's .rpm for RHEL, Rocky and Alma Linux 10. WebKitGTK 4.1 comes from EPEL there, so the
# package needs EPEL enabled. (EL9 has no WebKitGTK 4.1 at all, which Tauri 2 needs.)
FROM docker.io/rockylinux/rockylinux:10
RUN dnf -y install epel-release dnf-plugins-core && dnf config-manager --set-enabled crb \
    && dnf -y install gcc gcc-c++ make cmake perl curl wget file pkgconf-pkg-config xz \
       webkit2gtk4.1-devel openssl-devel librsvg2-devel gtk3-devel libsoup3-devel \
    && (dnf -y install libxdo-devel libappindicator-gtk3-devel || true) \
    && dnf clean all
RUN curl -fsSL https://nodejs.org/dist/v22.23.1/node-v22.23.1-linux-x64.tar.xz | tar -xJ -C /opt \
    && ln -s /opt/node-v22.23.1-linux-x64/bin/* /usr/local/bin/
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH=/root/.cargo/bin:$PATH
