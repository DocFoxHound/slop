#!/bin/sh
# Scans one file with SLAPorSLOP's scanner container and prints the verdict as JSON (scan.rs runs this).
# Usage: slop-scan <path> [file name], slop-scan --match-hashes, or slop-scan --source <archive>
# (the source check, on a repository's .tar.gz, for the scanning server). No network, read-only root, no
# capabilities, limited memory, processes, time and scratch space: the file is only read, never
# run. The file goes in on
# stdin and the scanner runs as its own unprivileged user, which is an unmapped ID outside the
# container (not this account), so a parser bug that escaped would hold nothing of ours. podman's
# --timeout stops the container itself, not only this command, if a scan hangs.
set -eu
run() {
  entrypoint=
  if [ "$1" = --source-check ]; then
    shift
    entrypoint=--entrypoint=slop-source-check
  fi
  # shellcheck disable=SC2086 # empty, or one word
  exec podman run --rm -i $entrypoint --network=none --read-only --cap-drop=ALL --security-opt=no-new-privileges \
    --pids-limit=256 --memory=4g --memory-swap=4g --cpus=4 --tmpfs /tmp:rw,size=6g,mode=1777 --timeout=1500 \
    -v slop-scan-db:/db:ro \
    localhost/slop-scanner "$@"
}
# slop-scan --match-hashes: fingerprints on stdin, checked against today's ClamAV signatures.
if [ "${1:-}" = --match-hashes ]; then
  run --match-hashes
fi
# slop-scan --source <archive>: the source check on a repository archive, on stdin.
if [ "${1:-}" = --source ]; then
  run --source-check - <"$2"
fi
path=$1
name=${2:-$(basename "$path")}
# Only the extension matters to the scanner; keep it to plain characters.
name=$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_')
case "$name" in .*|"") name=file$name ;; esac
run - "$name" <"$path"
