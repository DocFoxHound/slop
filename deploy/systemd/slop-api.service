[Unit]
Description=Slop API and website
After=slop-pg.service network-online.target
Wants=slop-pg.service

[Service]
EnvironmentFile=%h/.config/slop/slop.env
ExecStart=%h/slop-deploy/current/slop-api serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
# Not PrivateTmp: in a user service it adds a user namespace, and the release scanner's rootless
# podman can't start from inside one. Downloads being scanned go to a private folder instead.
Environment=TMPDIR=%h/slop-deploy/tmp
ExecStartPre=/usr/bin/mkdir -p -m 700 %h/slop-deploy/tmp

[Install]
WantedBy=default.target
