[Unit]
Description=SLAPorSLOP simulation sandbox (made-up apps, players and votes; docs/SIMULATION.md)
After=slop-pg.service network-online.target
Wants=slop-pg.service

[Service]
EnvironmentFile=%h/.config/slop/slop-sim.env
ExecStart=%h/slop-deploy/current/slop-api serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
