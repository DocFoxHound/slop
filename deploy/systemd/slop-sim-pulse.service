[Unit]
Description=Slop simulation sandbox: keeps simulated "playing now" alive
After=slop-sim.service
Wants=slop-sim.service

[Service]
EnvironmentFile=%h/.config/slop/slop-sim.env
ExecStart=%h/slop-deploy/current/slop-api simulate pulse
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
