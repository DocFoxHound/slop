# The deploy's build and test environment (deploy/update.sh, deploy/build/build.sh). Commits from
# main are built and tested in here, with the source and a cache folder mounted and nothing else:
# no home folder, no secrets, no SSH keys. Playwright's image brings Node and the browsers.
FROM mcr.microsoft.com/playwright:v1.64.1-noble@sha256:bdfda2a8fdf48707c5e50a49bd3e06d8d0c759153dc8ee057d8a81c3450bb3e9
ARG RUST_VERSION=1.99.1
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config libssl-dev python3 git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | CARGO_HOME=/opt/cargo sh -s -- -y --profile minimal --default-toolchain "$RUST_VERSION" \
        --component clippy --component rustfmt --no-modify-path \
    && chmod -R a+rX /opt/cargo /opt/rustup
